parcel-wrap-verb-wrap = Упаковать
parcel-wrap-verb-unwrap = Распаковать

parcel-wrap-popup-parcel-destroyed = Упаковка, содержащая { THE($contents) }, уничтожена!
parcel-wrap-popup-being-wrapped = {CAPITALIZE(THE($user))} пытается упаковать вас в свёрток!
parcel-wrap-popup-being-wrapped-self = Вы начинаете упаковывать себя в свёрток.

# Shown when parcel wrap is examined in details range
parcel-wrap-examine-detail-uses = { $uses ->
    [one] Осталось [color={$markupUsesColor}]{$uses}[/color] применение
    [few] Осталось [color={$markupUsesColor}]{$uses}[/color] применения
    *[many] Осталось [color={$markupUsesColor}]{$uses}[/color] применений
}.
